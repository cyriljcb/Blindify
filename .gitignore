# === .NET / Visual Studio (backend) ===
bin/
obj/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# === Flutter / Dart (app) ===
app/**/build/
app/**/.dart_tool/
app/**/.flutter-plugins
app/**/.flutter-plugins-dependencies
app/**/.packages
app/**/.pub-cache/
app/**/.pub/
app/**/ios/Pods/
app/**/ios/.symlinks/
app/**/ios/Flutter/Flutter.framework
app/**/ios/Flutter/Flutter.podspec
app/**/android/.gradle/
app/**/android/local.properties
app/**/*.g.dart
app/**/*.freezed.dart

# === Data (audio/covers/runtime — jamais dans le repo) ===
data/audio/
data/covers/
data/stats.json

# === Scripts Python (data/scripts) — exports intermédiaires, pas tracks.json ===
data/scripts/output/
data/scripts/__pycache__/
data/scripts/.venv/

# === Logs locaux (runs de dev, ex. backend_stdout.log/backend_stderr.log à la racine) ===
*.log

# === APK buildé localement, servi en statique par host/ pour installer sur les telephones sans
# cable (voir docs/architecture.md) — jamais commite, trop volumineux et vite obsolete. Idem pour
# le petit fichier de version associe (etat de deploiement, pas du code) ===
host/*.apk
host/apk_version.json

# === Éditeurs / OS ===
.vscode/
.idea/
*.DS_Store
Thumbs.db

# === Secrets ===
*.env
appsettings.*.local.json
